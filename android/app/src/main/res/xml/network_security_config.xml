<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, verified against the system certificate store. TLS checks are never relaxed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
