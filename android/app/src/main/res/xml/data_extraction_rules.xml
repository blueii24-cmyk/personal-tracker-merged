<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup and device-to-device transfer. Records (WebView storage) are included; the AI key is not. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="pt_secure_key.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="pt_secure_key.xml" />
    </device-transfer>
</data-extraction-rules>
