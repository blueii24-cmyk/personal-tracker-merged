# Placeholders only. For local Edge Functions, copy to supabase/functions/.env (git-ignored).
# For hosted Functions, enter real values with Supabase Edge Function secrets/configuration.
# Never copy these values into NEXT_PUBLIC_* variables, the Android app, Git, logs, or chat.
GOOGLE_CLIENT_ID=<GOOGLE_WEB_OAUTH_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_WEB_OAUTH_CLIENT_SECRET>
# Base64-encoded 32 random bytes. Keep a secure backup; losing it requires Google reconnection.
GOOGLE_TOKEN_ENC_KEY=<BASE64_ENCODED_32_RANDOM_BYTES>
# Primary web return origin first, then any other allowed web origins (comma-separated, no paths).
APP_ALLOWED_ORIGINS=https://<PRIMARY_WEB_ORIGIN>

# The callback is derived from SUPABASE_URL by the function; it is not a separate env value:
# https://<PROJECT_REF>.supabase.co/functions/v1/google-calendar/callback
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are supplied by the Supabase Functions runtime.
