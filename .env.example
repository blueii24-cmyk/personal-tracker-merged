# Safe by default: the app uses its clearly-labelled in-memory demo service.
NEXT_PUBLIC_BACKEND_MODE=demo

# Optional database mode for PRIVATE LOCAL DEVELOPMENT ONLY.
# This Sonnet-derived backend uses one shared workspace and does not yet include
# per-user authentication/RLS. Do not enable this on a public deployment.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
TRACKER_PRIVATE_SINGLE_USER=false

# Future provider adapters may use these server-only values. The current AI
# interpreter is deterministic and does not call an external model.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_CHAT_ENDPOINT=
