# Copy to .env.local (web) before `npm run build` / `node scripts/android.mjs debug`. NEVER commit real values.
# Both values are PUBLIC by design (they ship in the browser/APK bundle) and are protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
# Optional: where password-reset / confirmation e-mail links should land (a web page that hosts this app).
# NEXT_PUBLIC_AUTH_REDIRECT_URL=https://your-web-app.example

# Do NOT put these in this app or in any NEXT_PUBLIC_* variable. They belong only in Supabase Edge Function secrets
# (`supabase secrets set ...`): SUPABASE_SERVICE_ROLE_KEY (provided by the platform), GOOGLE_CLIENT_ID,
# GOOGLE_CLIENT_SECRET, GOOGLE_TOKEN_ENC_KEY, APP_ALLOWED_ORIGINS, AI_API_KEY and every other AI_* server setting.
# Android email confirmation/recovery uses com.blueii24.personaltracker://auth/callback automatically; do not put that
# native callback in NEXT_PUBLIC_AUTH_REDIRECT_URL. Allow-list it in Supabase Auth as well as the production web URL.
